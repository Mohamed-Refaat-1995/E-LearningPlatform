<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- Default IIS/IIS Express limit (~28.6 MB) sits below the ASP.NET Core
               pipeline and silently drops larger requests before any app code runs
               (including the [RequestSizeLimit] override on UploadVideo), which the
               browser then misreports as a CORS/network error. Raised to 1 GB for
               lesson video uploads. -->
          <requestLimits maxAllowedContentLength="1073741824" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
